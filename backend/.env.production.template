# Configurações do Supabase Oficial para Produção na HostGator
SUPABASE_URL=https://sua-url-do-supabase.supabase.co
SUPABASE_ANON_KEY=seu-token-anon-key-do-supabase

# Origens permitidas para requisições CORS (domínio do seu site frontend Next.js)
# Exemplo: https://gojuryukaratekai.com.br ou lista separada por vírgula
FRONTEND_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br

# Porta e Ambiente (FLASK_ENV deve ser 'production')
PORT=5000
FLASK_ENV=production

# Configurações de SMTP para envio de e-mails de resposta
SMTP_SERVER=mail.gojuryukaratekai.com.br
SMTP_PORT=587
SMTP_USER=contato@gojuryukaratekai.com.br
SMTP_PASSWORD=Contato@2026
SMTP_FROM_NAME=Goju-Ryu Karate Kai

# Integração de Pagamentos Asaas
# Para simulações locais, deixe em branco. Para homologação/produção, preencha.
ASAAS_API_KEY=sua_chave_asaas_v3_aqui
ASAAS_WEBHOOK_TOKEN=seu_segredo_webhook_aqui
ASAAS_SANDBOX=true

# Integração WhatsApp (Evolution API)
# Para simulações locais, deixe em branco.
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=sua_chave_global_aqui
EVOLUTION_INSTANCE=grkk_bot


